+/// Fallback used when no Android context was initialized (plain
+/// `exec`ed process, no NativeActivity): read the legacy
+/// `net.dns1`..`net.dns4` system properties via bionic's
+/// `__system_property_get`, and if none of them yields a usable IP,
+/// fall back to public resolvers. Never panics.
+fn read_system_conf_fallback() -> (ResolverConfig, ResolverOpts) {
+    warn!(
+        "android context not initialized; falling back to net.dns* \
+         system properties for DNS server configuration"
+    );
+
+    let mut nameservers = Vec::<NameServerConfig>::new();
+    for property in ["net.dns1", "net.dns2", "net.dns3", "net.dns4"] {
+        if let Some(ip) = system_property_ip(property) {
+            if !nameservers.iter().any(|ns| ns.ip == ip) {
+                nameservers.push(NameServerConfig::udp_and_tcp(ip));
+            }
+        }
+    }
+
+    if nameservers.is_empty() {
+        warn!(
+            "no DNS servers found in net.dns* system properties; \
+             falling back to public resolvers 1.1.1.1 and 8.8.8.8"
+        );
+        for ip in [
+            IpAddr::V4(Ipv4Addr::new(1, 1, 1, 1)),
+            IpAddr::V4(Ipv4Addr::new(8, 8, 8, 8)),
+        ] {
+            nameservers.push(NameServerConfig::udp_and_tcp(ip));
+        }
+    }
+
+    trace!("Got DNS servers (fallback): {:?}", nameservers);
+
+    (
+        ResolverConfig::from_parts(None, vec![], nameservers),
+        Default::default(),
+    )
+}
+
+/// Reads one Android system property and parses it as an IP address.
+/// Returns `None` for missing, unreadable, or non-IP values.
+fn system_property_ip(name: &str) -> Option<IpAddr> {
+    // PROP_VALUE_MAX (bionic's sys/system_properties.h), including
+    // room for the terminating NUL.
+    const PROP_VALUE_MAX: usize = 92;
+
+    let c_name = std::ffi::CString::new(name).ok()?;
+    let mut buffer = [0u8; PROP_VALUE_MAX];
+    // SAFETY: `c_name` is a valid NUL-terminated string and `buffer`
+    // has room for PROP_VALUE_MAX bytes, as __system_property_get
+    // requires; the call only writes into `buffer`.
+    let len = unsafe {
+        libc::__system_property_get(c_name.as_ptr(), buffer.as_mut_ptr() as *mut libc::c_char)
+    };
+    if len <= 0 {
+        return None;
+    }
+    let value = std::str::from_utf8(&buffer[..len as usize]).ok()?;
+    value.trim().parse::<IpAddr>().ok()
+}

