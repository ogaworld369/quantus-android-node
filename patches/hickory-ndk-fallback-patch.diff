-    let ctx = ndk_context::android_context();
+    // Local vendor patch (Quantus Android node): upstream calls
+    // `ndk_context::android_context()` here, which panics when no
+    // NativeActivity/runtime initialized the Android context. The
+    // Quantus node runs as a plain `exec`ed process, so the context is
