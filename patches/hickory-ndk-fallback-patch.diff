# Quantus Android node: ndk-context panic fix (vendor patches)
# Generated 2026-11-03T07:55:48Z against crates.io ndk-context 0.1.1 / hickory-resolver 0.26.1.
# Reproduce: copy the two registry crates into chain/vendor/, apply the three crate diffs,
# then add the [patch.crates-io] entries to chain/Cargo.toml (last hunk) and let cargo update Cargo.lock.

--- a/ndk-context-0.1.1/src/lib.rs
+++ b/vendor/ndk-context/src/lib.rs
@@ -72,6 +72,18 @@
     unsafe { ANDROID_CONTEXT.expect("android context was not initialized") }
 }
 
+/// Non-panicking variant of [`android_context()`]: returns the
+/// [`AndroidContext`] if it has been initialized, or `None` otherwise.
+///
+/// Local vendor patch (Quantus Android node): the node binary runs as a
+/// plain `exec`ed process with no NativeActivity, so nothing ever
+/// initializes the context. Callers that only need the context
+/// opportunistically (e.g. a DNS system-config lookup) can use this to
+/// fall back gracefully instead of panicking.
+pub fn try_android_context() -> Option<AndroidContext> {
+    unsafe { ANDROID_CONTEXT }
+}
