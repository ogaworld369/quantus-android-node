+/// Original upstream implementation: asks the ConnectivityManager for
+/// the active network's DNS servers over JNI. Unchanged.
+fn read_system_conf_jni(
+    ctx: ndk_context::AndroidContext,
+) -> Result<(ResolverConfig, ResolverOpts), ProtoError> {
     let vm = unsafe { jni::JavaVM::from_raw(ctx.vm().cast()) };
     vm.attach_current_thread(|env| {
         let activity = unsafe { JObject::from_raw(env, ctx.context().cast()) };
@@ -93,3 +111,66 @@
         ))
     })
 }
